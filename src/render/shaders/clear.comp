// src/render/shaders/clear.comp — M2 test pattern.
// Fills the internal image with a vertical gradient plus a moving wave so a
// screenshot proves the compute pass ran and the value changes over time.
#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform writeonly image2D out_img;

layout(push_constant) uniform PC {
    uint width;
    uint height;
    float time;
} pc;

void main() {
    ivec2 p = ivec2(gl_WorkGroupID.xy * uvec2(8) + gl_LocalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height))
        return;
    float v = float(p.y) / float(pc.height);
    vec3 c = mix(vec3(0.10, 0.10, 0.16), vec3(0.00, 0.42, 0.30), v);
    // Moving vertical stripes (time-dependent) + a frame counter bar.
    c += 0.12 * sin(float(p.x) * 0.06 + pc.time * 3.0) * vec3(1.0, 0.85, 0.5);
    if (p.y < 24)
        c = mix(c, vec3(0.75, 0.55, 0.15), 0.35);
    imageStore(out_img, p, vec4(c, 1.0));
}
