// w3d render/shaders/walls.comp — wall/floor/ceiling pass.
//
// One invocation per screen column (320 local invocations in a single
// workgroup; each invocation loops over the column's 200 rows itself).
// The CPU (frame.cpp) already ran the reference grid DDA and stored
// (t, h, tx, tex) per column; this pass ports the reference drawWalls
// output stage exactly: ceiling (palette 29) and floor (palette 25) plus
// the 64-texel wall strip with the reference's yf/stepf accumulation, so
// the texel-to-row mapping is identical to the JS.
//
// M4 fog (M5.1 fixed): per-pixel distance fog (PLAN: replaces the original
// 24-palette fog table, "visually equivalent"). Level L = min(23,
// floor(dist / step)); blend factor a = L/23 toward a brown ramp (FOG_NEAR
// at low levels, FOG_FAR at full fog). Walls use the column's ray distance
// (constant per column); floor/ceiling rows use the true plane distance
// d = (kWallHeight/2) / |row - 100| (eye at mid-wall height: the floor 0.5
// cells below the eye projects to row 100 + 80/D — column independent,
// nearest floor D = 0.81 at the screen edge, full fog at the horizon row).
// M4's per-column slope t/h * |row-100| was the wrong geometry (it fogged
// the nearest floor rows the hardest); the per-row table is now computed
// on the CPU and uploaded in the trailing columns-SSBO region. dist is in
// cells (the reference's zIndex units). The weapon is fogged in the sprite
// pass via its own distance (0 -> level 0 -> unmodified).
//
// The per-column fog inputs (wall-union rows wlo/whi) and the fog switch
// are computed on the CPU (renderer.cpp) and uploaded in
// the trailing region of the columns SSBO. Rationale: it keeps the shader
// free of any new expression forms (only SSBO reads, one multiply, one
// comparison-ternary — all shapes the DDA already exercises), and it makes
// the fog fully cross-checkable against the CPU model pixel by pixel.
//
// Driver facts proven this phase (value probes on the RTX Spark N1X
// ARM64 driver; see docs/phase-3-status.md M4):
// - UBO descriptor offsets must be 256-byte aligned: unaligned offsets are
//   silently clamped DOWN (33796 read the 33792 slot; 33808 read zeros).
// - `bool` UBO members are misplaced (probe read fog_on at offset 0).
// The fog switch is therefore a double pair (1.0/0.0, tested `< 0.5`) and
// the fog never uses a UBO at all.
//
// Verification note: the frame buffer's column region is 320 x 32B STRIDED
// records (t@0, h@8, tx@16, tex@24) — parsing it as two flat double arrays
// (or the 40B sprite records as 4-double records) yields a phantom
// "column permutation" and phantom level errors (bit me once, 2026-11-13).
#version 460

layout(local_size_x = 320) in;

struct Col {
    double t;
    double h;
    double tx;
    uint tex;
};
// Trailing fog region (all computed on the CPU, std430 offsets):
// fog_invstep @10240, fog_on @10248, rowdist[320] @10256 (first 200 =
// floor/ceiling plane distance per screen row), wlo_arr[320] @12816 /
// whi_arr[320] @14096 (wall-union row bounds). The region ends at 15376 <
// 16384 (the sprites sub-region).
layout(set = 0, binding = 0) buffer Columns {
    Col columns[320];
    double fog_invstep;
    double fog_on;
    double rowdist[320];
    int wlo_arr[320];
    int whi_arr[320];
} cb;

layout(set = 0, binding = 1) buffer WallAtlas { uint texel[]; };
layout(set = 0, binding = 3) buffer Palette { uint color[256]; };
layout(set = 0, binding = 6, rgba8) uniform writeonly image2D screen;

// Fog brown ramp (0-255 float space).
const vec3 FOG_NEAR = vec3(140.0, 92.0, 40.0);
const vec3 FOG_FAR = vec3(24.0, 14.0, 6.0);

// dist in cells -> fogged 255-space vec3 (in = 255-space).
vec3 fog_mixed(vec3 c, double dist) {
    if (cb.fog_on < 0.5 || cb.fog_invstep <= 0.0)
        return c;
    uint L = min(23u, uint(dist * cb.fog_invstep));
    if (L == 0u)
        return c;
    float u = float(L) / 23.0;
    vec3 fc = mix(FOG_NEAR, FOG_FAR, u);
    return c * (1.0 - u) + fc * u;
}

void main() {
    uint x = gl_LocalInvocationID.x;
    Col c = cb.columns[x];
    double h = c.h;                 // wall half-height in px (wallHeight/2t)
    double top = 100.0 - h;         // wall top edge (reference H/2 - h)
    double s = h / 32.0;            // px per texel (reference h/32)
    double stepi = floor(s);        // integer rows per texel
    double stepf = s - stepi;       // fractional remainder
    // Reference ~~(64 * tx): tx is [0,1] and can be exactly 1.0 (a ray
    // that starts on a cell boundary, extreme screen columns). JS then
    // indexes column 64 — i.e. column 0 of the NEXT texture (the 4096-byte
    // offset arithmetic overflows into the next chunk). Replicate that;
    // the clamp stops the read at the last tile of the base VSWAP bank
    // (106 wall chunks; SOD reuses the same bank), which is where the
    // reference's own read would run past the shipped data anyway.
    uint texcol = uint(floor(64.0 * c.tx));
    uint tidx = c.tex + (texcol > 63u ? 1u : 0u);
    texcol = (texcol > 63u ? 0u : texcol);
    if (tidx > 105u)
        tidx = 105u;
    // Wall atlas is row-major (row*64+col); the reference reads the 64
    // texels of column texcol top to bottom.
    uint base = tidx * 4096u + texcol;

    // Reference prefill (drawWalls): ceiling rows j = 0..yi (j <= yi0) and
    // floor rows pixelHeight-1-j = 199..199-yi0, where yi0 = ~~(100 - h).
    // The two bands OVERLAP the wall region (ceiling reaches row yi0, the
    // wall's first row; floor starts at 199-yi0, adjacent to the wall's
    // last row) and the wall DDA below overwrites its own union. Using
    // floor(top + 2h) as the boundary here was off by one row when top is
    // near an integer: the reference's floor starts at 199 - ~~(100-h),
    // not at floor(100-h+2h).
    double ytrunc = (top >= 0.0) ? floor(top) : ceil(top);  // JS ~~
    const int yi0 = int(ytrunc);
    uint rows[200];
    for (uint row = 0u; row < 200u; ++row)
        rows[row] = (int(row) <= yi0) ? color[29]
                 : (int(row) >= 199 - yi0) ? color[25]
                 : 0u;  // wall region: the DDA below writes every row of it

    // Reference 64-texel vertical DDA. yi/yf start at the wall's top edge
    // (reference: yi = ~~(H/2 - h), yf = (H/2 - h) % 1).
    double yi = ytrunc;
    double yf = top - ytrunc;
    for (uint j = 0u; j < 64u; ++j) {
        // DRIVERS BUG (2026-11-12): this ARM64 Vulkan driver miscompiles
        // `v & 0xFF` into a nonzero-test (0 or 0xFF). Use % 256 arithmetic
        // for every byte extraction / low-byte index in this project.
        uint px = color[texel[base + j * 64u] % 256u];
        yf += stepf;
        double n = stepi;
        if (yf >= 1.0) {
            n = stepi + 1.0;
            yf -= 1.0;
        }
        for (double k = 0.0; k < n; ++k) {
            double r = yi + k;
            if (r >= 0.0 && r < 200.0)
                rows[int(r)] = px;
        }
        yi += n;
    }

    // M4 fog (inputs uploaded by the CPU — see the header notes). Rows
    // inside the wall union use the column distance t; all other rows are
    // floor/ceiling and use the per-row plane distance table (80/|row-100|,
    // computed on the CPU; the horizon row saturates to full fog).
    const int wl = cb.wlo_arr[x];
    const int wh = cb.whi_arr[x];

    for (uint row = 0u; row < 200u; ++row) {
        uint pxv = rows[row];
        const double d =
            (int(row) >= wl && int(row) < wh)
                ? c.t
                : cb.rowdist[row];
        vec3 col = vec3(float(pxv % 256u), float((pxv / 256u) % 256u),
                        float((pxv / 65536u) % 256u));
        vec3 outc = fog_mixed(col, d);
        imageStore(screen, ivec2(int(x), int(row)),
                   vec4((outc.r + 0.5) / 255.0,
                        (outc.g + 0.5) / 255.0,
                        (outc.b + 0.5) / 255.0,
                        1.0));
    }
}
